{
  "name": "Trade Republic",
  "description": "Transaktionsexport aus der Trade-Republic-App. Geldbewegungen gehen ins gewählte Konto, alles mit Wertpapier zusätzlich in dessen Depot; Gebühren und Steuern sind im Betrag enthalten.",
  "encoding": "utf-8",
  "delimiter": ",",
  "dateFormats": ["YYYY-MM-DD"],
  "decimalSeparator": ".",
  "depot": true,
  "columns": {
    "date": "date",
    "timestamp": "datetime",
    "amount": "amount",
    "fee": "fee",
    "tax": "tax",
    "currency": "currency",
    "counterparty": ["counterparty_name", "name"],
    "purpose": ["description", "payment_reference", "type"],
    "transactionId": "transaction_id",
    "bookingText": "type",
    "section": "category",
    "counterpartyIban": "counterparty_iban",
    "paymentReference": "payment_reference",
    "mcc": "mcc_code",
    "isin": "symbol",
    "assetName": "name",
    "assetClass": "asset_class",
    "shares": "shares",
    "price": "price",
    "originalAmount": "original_amount",
    "originalCurrency": "original_currency",
    "fxRate": "fx_rate"
  }
}
